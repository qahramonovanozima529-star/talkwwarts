# ==============================================================================
# TALKWARTS ENVIRONMENT CONFIGURATION EXAMPLE
# ==============================================================================

# Database Connection (MongoDB)
# Format: mongodb+srv://<username>:<password>@cluster.mongodb.net/talkwarts?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:password@cluster.mongodb.net/talkwarts?retryWrites=true&w=majority

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=talkwarts_super_secure_nextauth_secret_key_minimum_32_characters_long_123456
JWT_SECRET=talkwarts_jwt_token_signing_secret_key_minimum_32_characters_random_987654

# Google OAuth Provider (Keep values trimmed without accidental leading/trailing spaces)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AI Engine Key (Gemini API / OpenAI API / DeepSeek)
# Used in src/app/api/garri-ai/route.ts for real-time speech evaluation and conversation
AI_API_KEY=your_gemini_or_openai_api_key_here

